<!-- Code style: human-code. -->
<environment>
  <use name="FWCore/Framework"/>
  <library file="SimHitCaloHitDumper.cc" name="SimHitCaloHitDumper">
    <use name="SimDataFormats/TrackingHit"/>
    <use name="SimDataFormats/CaloHit"/>
    <flags EDM_PLUGIN="1"/>
  </library>

  <library file="SimTrackSimVertexDumper.cc" name="SimTrackSimVertexDumper">
    <use name="SimDataFormats/GeneratorProducts"/>
    <use name="SimDataFormats/Track"/>
    <use name="SimDataFormats/Vertex"/>
    <flags EDM_PLUGIN="1"/>
  </library>

</environment>
<bin file="testSourceStacking.cc" name="testSourceStacking">
  <use name="SimG4Core/Application"/>
  <use name="SimG4Core/Generators"/>
  <use name="SimG4Core/Physics"/>
  <use name="FWCore/ParameterSetReader"/>
  <use name="geant4core"/>
</bin>
<test name="testExternalSourceStacking" command="testSourceStacking ${SCRAM_TEST_PATH}/testSourceStacking_cfg.py"/>
